# Copy to .env and fill in. npm run convert / npm run create-folder read it.
# For production, copy to .env.prod instead and use npm run convert:prod / create-folder:prod.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — the script detects each bucket's region on its own.
# AWS_REGION=ap-southeast-1
# Optional — the bucket create-folder uses when --bucket is not passed.
# BUCKET_NAME=my-bucket
